# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.1.1 Project Minimal Configuration


CONFIG_IDF_TARGET="esp32s3"
CONFIG_LCD_BOARD_SENSECAP_INDICATOR_D1=y

CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM=y
# 80 MHz, not the template's 120 MHz: octal PSRAM at 120 MHz is experimental
# and drifts out of timing as the chip warms up. A core dump showed a
# single-bit error reading a code constant from PSRAM (code and rodata run
# from PSRAM, see below), 34 min after boot.
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y


CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# CONFIG_ESP32S3_DATA_CACHE_64KB=y
# CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# CONFIG_ESP_IPC_TASK_STACK_SIZE=4096

# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_SLEEP_FLASH_LEAKAGE_WORKAROUND=n
# CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=n
# CONFIG_ESP_PHY_REDUCE_TX_POWER=y

CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP32_WIFI_RX_BA_WIN=6
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000


CONFIG_FREERTOS_HZ=1000
# Lets trimet_health log each task's unused stack (uxTaskGetSystemState).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y


CONFIG_LCD_AVOID_TEAR=y
CONFIG_LCD_LVGL_DIRECT_MODE=y
CONFIG_LCD_TASK_REFRESH_TIME=10
# 14 MHz pixel clock (template: 18): the panel streams its frame buffer from
# PSRAM, and at 80 MHz PSRAM there is not enough spare bandwidth for 18 MHz
# while the CPU is drawing (glitches on page changes).
CONFIG_LCD_EVB_SCREEN_FREQ=14


# CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_MEM_CUSTOM=y
# Allocator for lv_mem.c; CMakeLists.txt points LVGL's allocations at PSRAM.
CONFIG_LV_MEM_CUSTOM_INCLUDE="esp_heap_caps.h"
# CONFIG_LV_MEMCPY_MEMSET_STD=y
# CONFIG_LV_USE_ASSERT_NULL=y
# CONFIG_LV_USE_ASSERT_MALLOC=y
# CONFIG_LV_USE_PERF_MONITOR=y

CONFIG_LV_FONT_UNSCII_8=n
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y

CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_46=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# TLS buffers in PSRAM: internal RAM is shared with LVGL objects and ran out
# during concurrent HTTPS requests (mbedtls_ssl_setup -0x7F00).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Software SHA/AES: the hardware drivers' DMA path calls Cache_WriteBack_Addr
# on these PSRAM buffers without the cache lock (ESP-IDF 5.1), racing the LCD
# driver's writeback on the other core and deadlocking both (interrupt
# watchdog resets during TriMet fetches).
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_SHA=n

# Recover instead of hanging: reboot on a crash (the template halted, leaving
# a blank screen) and treat a task watchdog timeout as a crash. The LVGL task
# is also watched (lv_port.c).
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# Panic handler in IRAM, so it can still print a backtrace when the cache is
# stuck (from flash, interrupt watchdog resets printed nothing).
CONFIG_ESP_PANIC_HANDLER_IRAM=y
# Save a core dump to the coredump partition on a crash; read it later over
# USB with 'idf.py coredump-info'.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Firmware updates (Settings > Firmware). A new image must prove itself
# (trimet_ota.c) or the bootloader goes back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Internal RAM headroom (it fell to 7 KB free during an update check). Code
# runs from PSRAM anyway, so these trade speed we don't need for RAM:
# Wi-Fi functions out of internal RAM (~27 KB), and only the Wi-Fi features
# a station on a home network uses.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
# IPC task stacks (one per core): the template set 4096, and they use under
# 800 bytes. 2048 is the default when app tracing is on.
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
